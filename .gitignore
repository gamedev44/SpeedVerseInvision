# Unity .gitignore
# This file ensures Unity-generated files and build artifacts are excluded from version control

# ============================================
# Unity Generated Folders (should NOT be in git)
# ============================================

# Unity Library folder (contains all generated assets and caches)
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# Unity Asset meta data should only be ignored when the corresponding asset is also ignored
# We want to keep .meta files for assets that ARE tracked
# !/[Aa]ssets/**/*.meta

# ============================================
# Visual Studio / Rider / VS Code
# ============================================

# Visual Studio 2015/2017/2019/2022 user specific files
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs

# Rider
.idea/
*.sln.iml

# VS Code (keep settings that are project-specific, ignore user-specific)
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

