# Unity .gitattributes
# Git LFS file tracking configuration for Unity projects
# This file ensures binary assets are tracked with Git LFS for better performance

# ============================================
# Unity Binary Assets (should use LFS)
# ============================================

# Unity Scene files
*.unity filter=lfs diff=lfs merge=lfs -text

# Unity Prefab files
*.prefab filter=lfs diff=lfs merge=lfs -text

# Unity Asset files (ScriptableObjects, materials, etc.)
*.asset filter=lfs diff=lfs merge=lfs -text

# Unity Material files
*.mat filter=lfs diff=lfs merge=lfs -text

# Unity Animator Controller files
*.controller filter=lfs diff=lfs merge=lfs -text

# Unity Animation files
*.anim filter=lfs diff=lfs merge=lfs -text

# Unity Mesh files
*.mesh filter=lfs diff=lfs merge=lfs -text

# Unity Cubemap files
*.cubemap filter=lfs diff=lfs merge=lfs -text

# Unity Lighting data
*.lighting filter=lfs diff=lfs merge=lfs -text
*.lightmap filter=lfs diff=lfs merge=lfs -text

# Unity Physics materials
*.physicMaterial filter=lfs diff=lfs merge=lfs -text
*.physicsMaterial2D filter=lfs diff=lfs merge=lfs -text

# Unity Terrain files
*.terrain filter=lfs diff=lfs merge=lfs -text
*.terrainlayer filter=lfs diff=lfs merge=lfs -text

# Unity Build Report
*.buildreport filter=lfs diff=lfs merge=lfs -text

# Unity Asset Bundle
*.manifest filter=lfs diff=lfs merge=lfs -text

