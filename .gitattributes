# ============================================
# Git Files (keep as text)
# ============================================

*.gitattributes text eol=lf
*.gitignore text eol=lf
*.gitkeep text eol=lf

# ============================================
# Directory Patterns
# ============================================

# Raw Content directories (if used)
RawContent/**/* filter=lfs diff=lfs merge=lfs -text
Assets/RawContent/**/* filter=lfs diff=lfs merge=lfs -text

# Documentation directories
docs/**/*.pdf filter=lfs diff=lfs merge=lfs -text
docs/**/*.doc filter=lfs diff=lfs merge=lfs -text
docs/**/*.docx filter=lfs diff=lfs merge=lfs -text
docs/**/*.md text eol=lf

# ============================================
# Notes
# ============================================
#
# Unity-generated files that should NOT be in git (already in .gitignore):
# - Library/
# - Temp/
# - Logs/
# - obj/
# - Build/
# - *.csproj.user
# - *.suo
# - *.user
#
# This .gitattributes file handles file tracking for files that ARE in git.
# Binary assets use Git LFS, text files use normal git diff/merge.
#
# To set up Git LFS:
#   1. Install Git LFS: https://git-lfs.github.com/
#   2. Run: git lfs install
#   3. Run: git add .gitattributes
#   4. Run: git lfs track "*.<extension>"
#
